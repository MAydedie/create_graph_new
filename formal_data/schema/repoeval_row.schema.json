{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "formal_data/schema/repoeval_row.schema.json",
  "type": "object",
  "required": ["prompt", "metadata"],
  "properties": {
    "prompt": {"type": "string"},
    "metadata": {
      "type": "object",
      "required": ["task_id", "ground_truth", "fpath_tuple", "context_start_lineno"],
      "properties": {
        "task_id": {"type": "string"},
        "ground_truth": {"type": "string"},
        "fpath_tuple": {"type": "array"},
        "context_start_lineno": {"type": "integer"},
        "line_no": {"type": "integer"},
        "lineno": {"type": "integer"},
        "function_name": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
